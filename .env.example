# --- server ---
RPC_URL=https://rpc.monad.xyz
CHAIN_ID=143
PORT=8787
DB_PATH=./data/predmon.db
DYNAMIC_ENVIRONMENT_ID=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Three roles. Fund RELAYER_KEY (it pays gas for free votes); GATE/SETTLER spend little.
GATE_KEY=
SETTLER_KEY=
RELAYER_KEY=
RELAYER_MIN_MON=5
# {"0":"<Chainlink aggregator address on Monad for asset 0>"}
PRICE_FEEDS=
# public RPCs cap getLogs ranges
LOG_CHUNK=100
CORS_ORIGIN=https://your-app.example
# --- deploy (scripts/deploy.mjs) ---
DEPLOYER_KEY=
OWNER_ADDRESS=
GATE_ADDRESS=
SETTLER_ADDRESS=
MAX_STAKE=1
MAX_ENTRY=1
